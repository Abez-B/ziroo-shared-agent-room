# Copy this file to .env and fill in your own key. Never commit .env.

# Pick whichever provider you're using and set the matching key.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Optional: which model to call, if you want it configurable.
AGENT_MODEL=

# Optional: path to the SQLite database file.
DATABASE_PATH=./room.db
